# ─────────────────────────────────────────────────────────────────────────────
# Public site origin
# Used for absolute metadata URLs (OG/canonical) and for the product URL
# embedded in prefilled WhatsApp messages.
# Local development default: http://localhost:3000
# Production: set this to the real Studio Marmer domain.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Auth.js secret (admin authentication)
# Required by Auth.js to sign and encrypt session JWTs.
# NEVER commit a real value and NEVER expose it to client components.
#
# Generate one for local development with:
#   npx auth secret
#   # or, without the Auth.js CLI:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# This template intentionally ships an empty value.
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Database connection (MySQL)
# Copy this file to `.env` and fill in your real credentials.
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# ─────────────────────────────────────────────────────────────────────────────
# Seed admin account (optional)
# Only used by `npm run db:seed`. If these are absent, the seed skips
# creating the admin user entirely.
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-running-the-seed"
SEED_ADMIN_NAME="Store Admin"
