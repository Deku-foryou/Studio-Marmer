generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

/// How `price` should be interpreted when displayed.
enum PricingType {
  /// `price` is the exact selling price.
  FIXED
  /// `price` is the entry price; the final figure may be higher.
  STARTING_FROM
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  /// Cloudinary delivery URL for the category photo. Nullable — a category is
  /// perfectly valid without one.
  imageUrl    String?  @db.VarChar(500)
  /// Cloudinary asset id behind `imageUrl`. Stored so the remote asset can be
  /// identified for later replacement or cleanup instead of being inferred from
  /// the delivery URL. Always written and cleared together with `imageUrl`.
  publicId    String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id               Int       @id @default(autoincrement())
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId       Int

  name             String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(220)
  shortDescription String  @db.VarChar(500)
  description      String  @db.Text

  /// Selling price. Always required - there is no "contact us" / no-price state.
  /// Display it as an exact figure when `pricingType` is FIXED, and as a
  /// lower bound ("starting from") when `pricingType` is STARTING_FROM.
  price        Decimal      @db.Decimal(12, 2)
  pricingType  PricingType  @default(FIXED)
  /// Optional strike-through reference price. Discount percentage is NOT
  /// stored - derive it from `price` / `originalPrice` at render time.
  /// Invariant (enforced by a DB CHECK constraint where supported):
  /// `originalPrice IS NULL OR originalPrice > price`.
  originalPrice Decimal?     @db.Decimal(12, 2)

  /// Mandatory product attributes. These are enforced as NOT NULL at the
  /// database level - a product cannot be saved without them.
  color        String  @db.VarChar(120)
  material     String? @db.VarChar(120)
  stoneType    String  @db.VarChar(120)
  dimensions   String  @db.VarChar(120)
  weightGrams  Int
  specifications Json?

  craftingTime String? @db.VarChar(120)

  isAvailable   Boolean @default(true)
  isUniquePiece Boolean @default(false)

  shopeeUrl       String? @db.VarChar(500)
  whatsappEnabled Boolean @default(true)

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images ProductImage[]

  @@index([categoryId])
  @@index([isAvailable, isFeatured])
  @@index([price])
  @@index([stoneType])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId Int
  imageUrl  String   @db.VarChar(500)
  altText   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  /// Cloudinary asset identifier. Stored so the remote asset can be replaced or
  /// deleted later without guessing from the delivery URL. Nullable because an
  /// image may predate Cloudinary hosting (or be hosted elsewhere entirely).
  publicId  String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model SiteSettings {
  id             Int      @id @default(1)
  siteName       String   @db.VarChar(120)
  logoUrl        String?  @db.VarChar(500)
  whatsappNumber String?  @db.VarChar(30)
  shopeeUrl      String?  @db.VarChar(500)
  instagramUrl   String?  @db.VarChar(500)
  tiktokUrl      String?  @db.VarChar(500)
  email          String?  @db.VarChar(255)
  address        String?  @db.VarChar(255)
  heroTitle      String?  @db.VarChar(200)
  heroSubtitle   String?  @db.VarChar(500)
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}
