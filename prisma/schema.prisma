generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id               Int       @id @default(autoincrement())
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId       Int

  name             String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(220)
  shortDescription String  @db.VarChar(500)
  description      String  @db.Text

  price Decimal @db.Decimal(12, 2)

  material       String?  @db.VarChar(120)
  stoneType      String?  @db.VarChar(120)
  dimensions     String?  @db.VarChar(120)
  weightGrams    Int?
  specifications Json?

  craftingTime String? @db.VarChar(120)

  isAvailable   Boolean @default(true)
  isUniquePiece Boolean @default(false)

  shopeeUrl       String? @db.VarChar(500)
  whatsappEnabled Boolean @default(true)

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images ProductImage[]

  @@index([categoryId])
  @@index([isAvailable, isFeatured])
  @@index([price])
  @@index([stoneType])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId Int
  imageUrl  String   @db.VarChar(500)
  altText   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model SiteSettings {
  id             Int      @id @default(1)
  siteName       String   @db.VarChar(120)
  logoUrl        String?  @db.VarChar(500)
  whatsappNumber String?  @db.VarChar(30)
  shopeeUrl      String?  @db.VarChar(500)
  instagramUrl   String?  @db.VarChar(500)
  tiktokUrl      String?  @db.VarChar(500)
  email          String?  @db.VarChar(255)
  address        String?  @db.VarChar(255)
  heroTitle      String?  @db.VarChar(200)
  heroSubtitle   String?  @db.VarChar(500)
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}
